# Environment Variables Template for Docker Deployment
# Copy this file to .env.docker and customize the values for your deployment

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node.js Environment
NODE_ENV=production

# OpenCut Docker Image Version (latest, v0.1.0, sha-abc123, etc.)
OPENCUT_VERSION=latest

# =============================================================================
# PORT CONFIGURATION
# =============================================================================

# Web application port (default: 3100)
WEB_PORT=3100

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# Redis port (default: 6379)  
REDIS_PORT=6379

# Redis HTTP interface port (default: 8079)
REDIS_HTTP_PORT=8079

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
# Examples:
#   Local: postgresql://opencut:opencutthegoat@localhost:5432/opencut
#   Docker: postgresql://opencut:opencutthegoat@db:5432/opencut
#   External: postgresql://user:pass@external-db.example.com:5432/opencut
DATABASE_URL=postgresql://opencut:opencutthegoat@db:5432/opencut

# PostgreSQL Configuration (used by docker-compose for database service)
POSTGRES_USER=opencut
POSTGRES_PASSWORD=opencutthegoat
POSTGRES_DB=opencut

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Better Auth Secret (REQUIRED)
# Generate with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET=your-generated-secret-here

# Better Auth URL (Public URL where your app will be accessible)
# Examples:
#   Local: http://localhost:3000
#   Production: https://your-domain.com
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Configuration for Session Storage
# Examples:
#   Local serverless-redis-http: http://localhost:8079
#   Upstash Redis: https://your-redis-url.upstash.io
#   External Redis: http://your-redis-host:6379
UPSTASH_REDIS_REST_URL=http://serverless-redis-http:80

# Redis Token
# For serverless-redis-http: use "example_token" for local development
# For Upstash: use your actual Upstash token
UPSTASH_REDIS_REST_TOKEN=example_token

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Disable Next.js Telemetry (recommended for production)
NEXT_TELEMETRY_DISABLED=1

# Enable bundle analyzer (development only)
# ANALYZE=true

# =============================================================================
# EXTERNAL SERVICES (Optional - for blog functionality)
# =============================================================================

# Marble CMS Configuration (for blog)
# MARBLE_WORKSPACE_KEY=your-marble-workspace-key
# NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================

# 1. NEVER use default passwords in production
# 2. Generate strong, unique secrets for BETTER_AUTH_SECRET
# 3. Use proper PostgreSQL credentials
# 4. Configure proper CORS origins for NEXT_PUBLIC_BETTER_AUTH_URL
# 5. Use HTTPS URLs in production for NEXT_PUBLIC_BETTER_AUTH_URL
# 6. Consider using Docker secrets for sensitive values
# 7. Regularly rotate secrets and passwords

# =============================================================================
# DOCKER COMPOSE USAGE
# =============================================================================

# To use with docker-compose:
# 1. Copy this file to .env.docker
# 2. Customize the values above
# 3. Run: docker-compose --env-file .env.docker -f docker-compose.prod.yaml up -d

# =============================================================================
# KUBERNETES DEPLOYMENT
# =============================================================================

# For Kubernetes, convert these to ConfigMaps and Secrets:
# kubectl create secret generic opencut-secrets \
#   --from-literal=BETTER_AUTH_SECRET="your-secret" \
#   --from-literal=DATABASE_URL="your-db-url" \
#   --from-literal=UPSTASH_REDIS_REST_TOKEN="your-token"

# kubectl create configmap opencut-config \
#   --from-literal=NODE_ENV="production" \
#   --from-literal=NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.com" \
#   --from-literal=UPSTASH_REDIS_REST_URL="your-redis-url"
